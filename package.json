{
  "name": "dreamkur-job",
  "version": "1.0.0",
  "description": "dreamkur -job — Smart Job Radar & AI Career Assistant (fokus Banda Aceh, Aceh Besar, Remote Indonesia & Remote Global)",
  "private": true,
  "engines": {
    "node": "^22.13.0 || >=23.4.0"
  },
  "scripts": {
    "doctor": "node doctor.mjs",
    "ui": "node scripts/ui-server.mjs",
    "verify": "node verify-pipeline.mjs",
    "lint": "node scripts/check-syntax.mjs",
    "merge": "node merge-tracker.mjs",
    "pdf": "node generate-pdf.mjs",
    "cover-letter": "node generate-cover-letter.mjs --payload",
    "cv:verify-facts": "node verify-cv-facts.mjs",
    "cv:verify-ats": "node verify-ats.mjs",
    "liveness": "node check-liveness.mjs",
    "extract": "node browser-extract.mjs",
    "scan": "node scan.mjs",
    "scan:full": "node scan-ats-full.mjs",
    "scan:seeds": "node scan-ats-full.mjs --seeds yc,a16z",
    "scan:yc": "node scan-ats-full.mjs --seeds yc",
    "scan:dayforce": "node scan-dayforce.mjs",
    "scan:hn": "node scan-hn.mjs",
    "scan:seek": "node scan-seek.mjs",
    "validate:portals": "node validate-portals.mjs",
    "verify:portals": "node verify-portals.mjs",
    "tracker": "node tracker.mjs",
    "find": "node find.mjs",
    "archive": "node archive-posting.mjs",
    "postinstall": "node -e \"process.exit(['','0','false'].includes((process.env.PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD||'').toLowerCase())?1:0)\" || npx playwright install chromium || node -e \"console.warn('\\ndreamkur -job: could not install Playwright Chromium. Everything else is installed; PDF generation and browser checks need it. Run: npx playwright install chromium')\""
  },
  "keywords": [
    "dreamkur-job",
    "job-search",
    "aceh",
    "remote-global",
    "ai-career"
  ],
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "dotenv": "^18.0.4",
    "js-yaml": "^5.3.0",
    "playwright": "1.64.1",
    "undici": "^7.30.1"
  }
}
